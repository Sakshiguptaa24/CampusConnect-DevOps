# ============================================
# CampusConnect — Environment Configuration Template
# ============================================

# Database Configuration
# Local dev default (SQLite): sqlite+aiosqlite:///./campusconnect.db
# Docker production (PostgreSQL): postgresql+asyncpg://postgres:postgres@postgres:5432/campusconnect
DATABASE_URL=sqlite+aiosqlite:///./campusconnect.db

# JWT Security
SECRET_KEY=campusconnect-secret-key-change-in-production-2024
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Admin Seed Credentials
ADMIN_EMAIL=admin@campusconnect.com
ADMIN_PASSWORD=Admin@123

# Initial Student Demo Credentials
STUDENT_EMAIL=student@campusconnect.com
STUDENT_PASSWORD=Student@123

# Host & Ports
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
